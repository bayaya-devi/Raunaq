{
  "name": "raunaq-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-30",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "raunaq",
      "database_id": "REPLACE_WITH_WRANGLER_D1_DATABASE_ID"
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "ORDER_QUEUE",
        "queue": "raunaq-orders"
      }
    ]
  },
  "ratelimits": [
    {
      "name": "ORDER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "vars": {
    "ALLOWED_ORIGIN": "https://bayaya-devi.github.io"
  }
}